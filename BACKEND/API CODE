incidents_mgmt_router = FastAPI()

@incidents_mgmt_router.get("", response_model=List[IncidentSummary])
def get_incidents(
    status: Optional[str] = Query(None),
    incident_type: Optional[str] = Query(None),
    start_date: Optional[datetime] = Query(None),
    end_date: Optional[datetime] = Query(None),
    current_user: SystemUser = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    query = db.query(Incident).join(Tourist)
    if status:
        query = query.filter(Incident.status == status)
    if incident_type:
        query = query.filter(Incident.incident_type == incident_type)
    if start_date:
        query = query.filter(Incident.start_timestamp >= start_date)
    if end_date:
        query = query.filter(Incident.start_timestamp <= end_date)
    incidents = query.order_by(Incident.start_timestamp.desc()).all()
    
    # Manually construct response to include tourist name
    response = []
    for inc in incidents:
        response.append(IncidentSummary(
            incident_id=inc.incident_id,
            tourist_id=inc.tourist_id,
            incident_type=inc.incident_type,
            status=inc.status,
            start_timestamp=inc.start_timestamp,
            tourist_name=inc.tourist.full_name
        ))
    return response

@incidents_mgmt_router.get("/{incident_id}", response_model=IncidentDetails)
def get_incident_details(incident_id: int, current_user: SystemUser = Depends(get_current_user), db: Session = Depends(get_db)):
    incident = db.query(Incident).filter(Incident.incident_id == incident_id).first()
    if not incident:
        raise HTTPException(status_code=404, detail="Incident not found")
    
    tourist = incident.tourist
    tourist_profile = TouristProfile(
        tourist_id=tourist.tourist_id,
        full_name=tourist.full_name,
        photo_url=tourist.photo_url,
        blood_type=tourist.blood_type,
        digital_id_details=DigitalIdDetails.from_orm(tourist.digital_id) if tourist.digital_id else None,
        trip_details=tourist.trips,
        emergency_contacts=tourist.emergency_contacts
    )

    return IncidentDetails(
        **incident.__dict__,
        tourist_profile=tourist_profile,
        incident_logs=incident.logs
    )

@incidents_mgmt_router.post("/{incident_id}/acknowledge", response_model=IncidentOut)
def acknowledge_incident(incident_id: int, current_user: SystemUser = Depends(get_current_user), db: Session = Depends(get_db)):
    incident = db.query(Incident).filter(Incident.incident_id == incident_id).first()
    if not incident:
        raise HTTPException(status_code=404, detail="Incident not found")
    if incident.acknowledged_by_user_id is not None:
        raise HTTPException(status_code=400, detail="Incident already acknowledged")
    
    incident.acknowledged_by_user_id = current_user.user_id
    incident.status = "Acknowledged"
    db.commit()
    db.refresh(incident)
    return incident

@incidents_mgmt_router.post("/{incident_id}/logs", response_model=IncidentLogOut, status_code=status.HTTP_201_CREATED)
def add_incident_log(incident_id: int, log_data: IncidentLogCreate, current_user: SystemUser = Depends(get_current_user), db: Session = Depends(get_db)):
    incident = db.query(Incident).filter(Incident.incident_id == incident_id).first()
    if not incident:
        raise HTTPException(status_code=404, detail="Incident not found")
    
    new_log = IncidentLog(
        incident_id=incident_id,
        user_id=current_user.user_id,
        **log_data.dict()
    )
    db.add(new_log)
    db.commit()
    db.refresh(new_log)
    return new_log

@incidents_mgmt_router.put("/{incident_id}/status", response_model=IncidentOut)
def update_incident_status(incident_id: int, status_update: IncidentStatusUpdate, current_user: SystemUser = Depends(get_current_user), db: Session = Depends(get_db)):
    incident = db.query(Incident).filter(Incident.incident_id == incident_id).first()
    if not incident:
        raise HTTPException(status_code=404, detail="Incident not found")
    incident.status = status_update.status
    if status_update.status in ["Resolved", "Closed"]:
        incident.end_timestamp = datetime.utcnow()
    db.commit()
    db.refresh(incident)
    return incident

@incidents_mgmt_router.post("/{incident_id}/efir", response_model=EFIRResponse, status_code=status.HTTP_201_CREATED)
def create_efir(incident_id: int, efir_data: EFIRCreateRequest, current_user: SystemUser = Depends(get_current_user), db: Session = Depends(get_db)):
    incident = db.query(Incident).filter(Incident.incident_id == incident_id).first()
    if not incident:
        raise HTTPException(status_code=404, detail="Incident not found")
    if incident.efir:
        raise HTTPException(status_code=400, detail="E-FIR already exists for this incident")

    tourist = incident.tourist
    report_details = f"E-FIR for incident ID {incident_id}\n"
    report_details += f"Tourist Name: {tourist.full_name}\n"
    report_details += f"Incident Type: {incident.incident_type}\n"
    report_details += f"Start Time: {incident.start_timestamp}\n"
    report_details += f"Location: {incident.last_known_latitude}, {incident.last_known_longitude}\n\n"
    report_details += f"Additional Details:\n{efir_data.additional_report_details}"
    
    new_efir = EFIR(
        incident_id=incident_id,
        efir_number=f"EFIR-{datetime.utcnow().year}-{incident_id}",
        generated_by_user_id=current_user.user_id,
        report_details=report_details
    )
    db.add(new_efir)
    db.commit()
    db.refresh(new_efir)
    return new_efir

app.include_router(incidents_mgmt_router, prefix="/incidents", tags=["Incident Management"])


