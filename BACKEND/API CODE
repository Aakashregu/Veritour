# --- Authentication (auth.py) ---
def verify_password(plain_password, hashed_password):
    return pwd_context.verify(plain_password, hashed_password)

def get_password_hash(password):
    return pwd_context.hash(password)

def create_access_token(data: dict, expires_delta: Optional[timedelta] = None):
    to_encode = data.copy()
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=15)
    to_encode.update({"exp": expire})
    encoded_jwt = jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt

def get_current_user(token: str = Depends(oauth2_scheme), db: Session = Depends(get_db)):
    credentials_exception = HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Could not validate credentials",
        headers={"WWW-Authenticate": "Bearer"},
    )
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        user_id: str = payload.get("id")
        user_type: str = payload.get("user_type")
        if user_id is None or user_type != "system_user":
            raise credentials_exception
        token_data = TokenData(id=user_id, user_type=user_type)
    except JWTError:
        raise credentials_exception
    user = db.query(SystemUser).filter(SystemUser.user_id == token_data.id).first()
    if user is None or not user.is_active:
        raise credentials_exception
    return user

def get_current_tourist(token: str = Depends(oauth2_scheme), db: Session = Depends(get_db)):
    credentials_exception = HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Could not validate credentials",
        headers={"WWW-Authenticate": "Bearer"},
    )
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        tourist_id: str = payload.get("id")
        user_type: str = payload.get("user_type")
        if tourist_id is None or user_type != "tourist":
            raise credentials_exception
        token_data = TokenData(id=tourist_id, user_type=user_type)
    except JWTError:
        raise credentials_exception
    tourist = db.query(Tourist).filter(Tourist.tourist_id == token_data.id).first()
    if tourist is None:
        raise credentials_exception
    return tourist


