):
    query = db.query(GeoFencedZone)
    if is_active is not None:
        if is_active:
            now = datetime.utcnow()
            query = query.filter(GeoFencedZone.active_start_time <= now, (GeoFencedZone.active_end_time == None) | (GeoFencedZone.active_end_time >= now))
