@onboarding_router.post("/verify-document", response_model=DocumentVerificationResponse)
def verify_document(request: DocumentVerificationRequest, db: Session = Depends(get_db)):
    # This is a mock verification. In a real system, this would call a government API.
    if request.document_number.startswith("VALID"): # Mock condition
        # Check if tourist already exists
        existing_digital_id = db.query(DigitalID).filter(DigitalID.document_number == request.document_number).first()
        if existing_digital_id:
             raise HTTPException(status_code=400, detail="Document number already registered.")

        # Create a new tourist record upon successful mock verification
        tourist_details = VerifiedTouristDetails(full_name="John Doe", photo_url="http://example.com/photo.jpg")
        new_tourist = Tourist(
            full_name=tourist_details.full_name,
            photo_url=tourist_details.photo_url,
            blood_type=tourist_details.blood_type
        )
        db.add(new_tourist)
        db.commit()
        db.refresh(new_tourist)

        return {
            "verification_status": "Success",
            "tourist_details": tourist_details,
            "verified_tourist_id": new_tourist.tourist_id
        }
    else:
        return {"verification_status": "Failed", "tourist_details": None, "verified_tourist_id": None}

@onboarding_router.post("/issue-id", response_model=DigitalIdResponse)
def issue_id(request: IssueIdRequest, db: Session = Depends(get_db)):
    tourist = db.query(Tourist).filter(Tourist.tourist_id == request.verified_tourist_id).first()
    if not tourist:
        raise HTTPException(status_code=404, detail="Verified tourist not found")

    # Create Trip
    new_trip = Trip(
        tourist_id=tourist.tourist_id,
        start_date=request.trip_start_date,
        end_date=request.trip_end_date,
        itinerary_details=request.itinerary_details
    )
    db.add(new_trip)

    # Add Emergency Contacts
    for contact in request.emergency_contacts:
        new_contact = EmergencyContact(tourist_id=tourist.tourist_id, **contact.dict())
        db.add(new_contact)

    # Create Digital ID
    # This should be a much more robust generation in production
    activation_token = secrets.token_urlsafe(32)
    digital_id_val = f"DID-{secrets.token_hex(8).upper()}"

    new_digital_id = DigitalID(
        digital_id=digital_id_val,
        tourist_id=tourist.tourist_id,
        document_type="Passport", # Mocked for now
        document_number=f"VALID-{secrets.token_hex(4)}", # Mocked for now
        expiry_date=request.trip_end_date,
        status="Issued",
        activation_qr_code=activation_token
    )
    db.add(new_digital_id)
    db.commit()
    db.refresh(new_digital_id)

    return {
        "digital_id": new_digital_id.digital_id,
        "issue_date": new_digital_id.issue_date,
        "expiry_date": new_digital_id.expiry_date,
        "status": new_digital_id.status,
        "activation_qr_code": new_digital_id.activation_qr_code
    }

app.include_router(onboarding_router, prefix="/onboarding", tags=["Onboarding"])

# --- Tourist Router ---
tourist_router = FastAPI()

@tourist_router.post("/activate", response_model=TouristActivateResponse)
def activate_tourist_profile(request: TouristActivateRequest, db: Session = Depends(get_db)):
    digital_id = db.query(DigitalID).filter(DigitalID.activation_qr_code == request.activation_token_from_qr).first()
    if not digital_id or digital_id.status != "Issued":
        raise HTTPException(status_code=400, detail="Invalid or already used activation token")

    digital_id.status = "Active"
    db.commit()
    db.refresh(digital_id)

    tourist = digital_id.tourist
    access_token = create_access_token(
        data={"id": str(tourist.tourist_id), "user_type": "tourist"},
        expires_delta=timedelta(days=30) # Longer token for tourists
    )

    return {
        "tourist_id": tourist.tourist_id,
        "full_name": tourist.full_name,
        "jwt_token": access_token
    }

@tourist_router.get("/me", response_model=TouristProfile)
def get_my_profile(current_tourist: Tourist = Depends(get_current_tourist), db: Session = Depends(get_db)):
    # Eagerly load related data to avoid multiple queries
    tourist = db.query(Tourist).filter(Tourist.tourist_id == current_tourist.tourist_id).one()
    digital_id_details = DigitalIdDetails.from_orm(tourist.digital_id) if tourist.digital_id else None
    
    return {
        "tourist_id": tourist.tourist_id,
        "full_name": tourist.full_name,
        "photo_url": tourist.photo_url,
        "blood_type": tourist.blood_type,
        "digital_id_details": digital_id_details,
        "trip_details": tourist.trips,
        "emergency_contacts": tourist.emergency_contacts
    }

@tourist_router.get("/me/emergency-contacts", response_model=List[EmergencyContact])
