@tourist_router.post("/me/emergency-contacts", response_model=EmergencyContact, status_code=status.HTTP_201_CREATED)
def add_emergency_contact(contact: EmergencyContactCreate, current_tourist: Tourist = Depends(get_current_tourist), db: Session = Depends(get_db)):
    db_contact = EmergencyContact(**contact.dict(), tourist_id=current_tourist.tourist_id)
    db.add(db_contact)
    db.commit()
