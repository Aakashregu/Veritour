@tourist_router.delete("/me/emergency-contacts/{contact_id}", response_model=StatusMessage)
def delete_emergency_contact(contact_id: int, current_tourist: Tourist = Depends(get_current_tourist), db: Session = Depends(get_db)):
    contact = db.query(EmergencyContact).filter(EmergencyContact.contact_id == contact_id, EmergencyContact.tourist_id == current_tourist.tourist_id).first()
    if not contact:
        raise HTTPException(status_code=404, detail="Contact not found")
    db.delete(contact)
    db.commit()
    return {"status": "success", "message": "Emergency contact deleted successfully"}

